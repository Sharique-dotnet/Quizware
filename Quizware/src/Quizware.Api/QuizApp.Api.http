PUT {{host}}/api/v1/programs/{{programId}}/stages/{{stageId}}
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "name": "League Stage"
}

### Validate Stage (before segments — expect not runnable)
# Expect: 200
# @name validateStage
POST {{host}}/api/v1/programs/{{programId}}/stages/{{stageId}}/validate
Authorization: Bearer {{scopedAccessToken}}

### Add Segment (MCQ)
# Expect: 200
# @name addSegment
POST {{host}}/api/v1/programs/{{programId}}/stages/{{stageId}}/segments
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "formatCode": "Mcq",
  "questionCount": 5,
  "isOrderLocked": true
}

###
@segmentId = {{addSegment.response.body.$.id}}

### Add Segment (Buzzer)
# Expect: 200
# @name addSegment2
POST {{host}}/api/v1/programs/{{programId}}/stages/{{stageId}}/segments
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "formatCode": "Buzzer",
  "questionCount": 4,
  "isOrderLocked": false
}

###
@secondSegmentId = {{addSegment2.response.body.$.id}}

### Validate Stage (after segments — expect runnable)
# Expect: 200
# @name validateStage2
POST {{host}}/api/v1/programs/{{programId}}/stages/{{stageId}}/validate
Authorization: Bearer {{scopedAccessToken}}

### Get Segments
# Expect: 200
# @name getSegments
GET {{host}}/api/v1/programs/{{programId}}/stages/{{stageId}}/segments
Authorization: Bearer {{scopedAccessToken}}

### Update Segment
# Expect: 200
# @name updateSegment
PUT {{host}}/api/v1/programs/{{programId}}/stages/{{stageId}}/segments/{{secondSegmentId}}
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "questionCount": 6,
  "isOrderLocked": false
}

### Reorder Segments (locked MCQ segment keeps its index)
# Expect: 200
# @name reorderSegments
PUT {{host}}/api/v1/programs/{{programId}}/stages/{{stageId}}/segments/reorder
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "orderedSegmentTemplateIds": ["{{secondSegmentId}}", "{{segmentId}}"]
}

### Set Segment Order Mode
# Expect: 200
# @name setSegmentOrderMode
PUT {{host}}/api/v1/programs/{{programId}}/stages/{{stageId}}/segment-order-mode
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "segmentOrderMode": "RandomPerMatch"
}

### Reorder Stages
# Expect: 200
# @name reorderStages
PUT {{host}}/api/v1/programs/{{programId}}/stages/reorder
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "orderedStageIds": ["{{secondStageId}}", "{{stageId}}"]
}

### Program Readiness Validate
# Expect: 200
# @name programReadinessValidate
POST {{host}}/api/v1/programs/{{programId}}/validate
Authorization: Bearer {{scopedAccessToken}}

### Remove Segment
# Expect: 204
# @name removeSegment
DELETE {{host}}/api/v1/programs/{{programId}}/stages/{{stageId}}/segments/{{secondSegmentId}}
Authorization: Bearer {{scopedAccessToken}}

### Delete Stage (Final — no matches yet)
# Expect: 204
# @name deleteStage
DELETE {{host}}/api/v1/programs/{{programId}}/stages/{{secondStageId}}
Authorization: Bearer {{scopedAccessToken}}


