###
### ==================== 07 · Questions ====================

### List Questions
# Expect: 200
# @name listQuestions
GET {{host}}/api/v1/programs/{{programId}}/questions?formatCode=Mcq
Authorization: Bearer {{scopedAccessToken}}

### Create MCQ Question
# Expect: 201
# @name createMCQQuestion
POST {{host}}/api/v1/programs/{{programId}}/questions/mcq
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "formatCode": "Mcq",
  "questionText": "What is the capital of France?",
  "difficultyLevelId": 2,
  "topicId": "{{topicId}}",
  "language": "en",
  "tagIds": ["{{tagId}}"],
  "options": [
    { "text": "Paris", "isCorrect": true, "displayOrder": 1, "mediaAssetId": null },
    { "text": "Rome", "isCorrect": false, "displayOrder": 2, "mediaAssetId": null }
  ],
  "allowMultipleCorrect": false,
  "shuffleOptions": true,
  "negativeMarkingEnabled": false
}

###
@mcqQuestionId = {{createMCQQuestion.response.body.$.id}}

### Create Buzzer Question
# Expect: 201
# @name createBuzzerQuestion
POST {{host}}/api/v1/programs/{{programId}}/questions/buzzer
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "formatCode": "Buzzer",
  "questionText": "Name the largest planet in the solar system.",
  "difficultyLevelId": 2,
  "language": "en",
  "tagIds": [],
  "options": [
    { "text": "Jupiter", "isCorrect": true, "displayOrder": 1, "mediaAssetId": null },
    { "text": "Saturn", "isCorrect": false, "displayOrder": 2, "mediaAssetId": null }
  ],
  "buzzWindowSeconds": 30,
  "lockoutOnWrongAnswer": true,
  "allowStealAfterWrong": true
}

### Get Question By Id
# Expect: 200
# @name getQuestionById
GET {{host}}/api/v1/programs/{{programId}}/questions/{{mcqQuestionId}}
Authorization: Bearer {{scopedAccessToken}}

### Update Question (creates a new version, links SupersedesQuestionId)
# Expect: 200
# @name updateQuestion
PUT {{host}}/api/v1/programs/{{programId}}/questions/mcq/{{mcqQuestionId}}
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "formatCode": "Mcq",
  "questionText": "What is the capital city of France?",
  "difficultyLevelId": 2,
  "topicId": "{{topicId}}",
  "language": "en",
  "tagIds": ["{{tagId}}"],
  "options": [
    { "text": "Paris", "isCorrect": true, "displayOrder": 1, "mediaAssetId": null },
    { "text": "Rome", "isCorrect": false, "displayOrder": 2, "mediaAssetId": null }
  ],
  "allowMultipleCorrect": false,
  "shuffleOptions": true,
  "negativeMarkingEnabled": false
}

###
@mcqQuestionIdV2 = {{updateQuestion.response.body.$.id}}

