# Quizware API — end-to-end request sequence for Visual Studio 2022 (17.12+) / VS Code REST Client.
#
# Generated from postman/Quizware.postman_collection.json, the newman-validated suite,
# so the two stay in step. Every request feeds the ids it creates into the requests below it.
#
# HOW TO USE
#   1. Start the API (F5). Set @host below to match the launch profile:
#        http profile  -> http://localhost:5155
#        https profile -> https://localhost:7041
#   2. Set @adminPassword to the seeded admin's current password. A fresh database seeds
#      KeepMeUpdated@123 (AdminUserSeeder); the seeder never touches an existing admin.
#   3. Click "Send request" on each request, TOP TO BOTTOM, without skipping. A request that
#      uses an id from an earlier one fails until that earlier one has been sent.
#   4. "# Expect:" is the status that means the step passed. Some steps are deliberate
#      negative checks (409, 404, 403, 400) and pass when they get that status.
#
# TOKENS
#   - accessToken: from Login/Refresh. Used for program management and admin calls.
#   - scopedAccessToken: from "Select Program". Used by every program-scoped call (04 onward).
#   - Both last 15 minutes. If calls start returning 401, re-send Login, Refresh and Select Program.
#   - Login and Refresh are limited to 5 requests per minute (429 RATE_LIMITED); five wrong
#     passwords lock the account for 15 minutes.
#
# NOT INCLUDED
#   - Excel imports and media upload (need a file), and the Buzzer folder (needs
#     Buzzer:Provider=HttpAgent). Use Postman or Scalar (/scalar) for those.
#   - Change password: POST {{host}}/api/v1/auth/change-password with the Login token and
#     { "currentPassword": "...", "newPassword": "..." } (8+ chars, upper, lower, digit, symbol).
#   - SignalR hubs (/hubs/match, /hubs/display) are not HTTP requests.

@host = https://localhost:7041
@adminEmail = admin@quizapp.local
@adminPassword = KeepMeUpdated@123

###
### ==================== 00 · Health ====================

### Liveness
# Expect: 200
# @name liveness
GET {{host}}/health/live

### Readiness (DB-backed)
# Expect: 200
# @name readiness
GET {{host}}/health/ready


###
### ==================== 01 · Auth ====================

### Login (seeded SuperAdmin)
# Expect: 200
# @name login
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
@accessToken = {{login.response.body.$.accessToken}}
@refreshToken = {{login.response.body.$.refreshToken}}

### Me
# Expect: 200
# @name me
GET {{host}}/api/v1/auth/me
Authorization: Bearer {{accessToken}}

### Refresh
# Expect: 200
# @name refresh
POST {{host}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###
@accessToken2 = {{refresh.response.body.$.accessToken}}
@refreshToken2 = {{refresh.response.body.$.refreshToken}}


###
### ==================== 02 · Programs ====================

### List Programs
# Expect: 200
# @name listPrograms
GET {{host}}/api/v1/programs
Authorization: Bearer {{accessToken2}}

### Create Program
# Expect: 201
# @name createProgram
POST {{host}}/api/v1/programs
Authorization: Bearer {{accessToken2}}
Content-Type: application/json

{
  "code": "PM-{{$randomInt 1000 999999}}",
  "name": "Postman Test Program",
  "description": "Created by the Quizware Postman collection"
}

###
@programId = {{createProgram.response.body.$.id}}

### Get Program By Id
# Expect: 200
# @name getProgramById
GET {{host}}/api/v1/programs/{{programId}}
Authorization: Bearer {{accessToken2}}

### Update Program
# Expect: 200
# @name updateProgram
PUT {{host}}/api/v1/programs/{{programId}}
Authorization: Bearer {{accessToken2}}
Content-Type: application/json

{
  "name": "Postman Test Program",
  "description": "Updated via Postman",
  "organisationName": "Quizware QA",
  "logoUrl": null,
  "themePrimaryColor": null,
  "themeSecondaryColor": null,
  "fontFamily": null,
  "maxTeams": 20
}

### Select Program (mint program-scoped token)
# Expect: 200
# @name selectProgram
POST {{host}}/api/v1/auth/select-program
Authorization: Bearer {{accessToken2}}
Content-Type: application/json

{
  "programId": "{{programId}}"
}

###
@scopedAccessToken = {{selectProgram.response.body.$.accessToken}}

### Display Token (read-only, cannot write)
# Expect: 200
# @name displayToken
POST {{host}}/api/v1/auth/display-token
Authorization: Bearer {{accessToken2}}
Content-Type: application/json

{
  "programId": "{{programId}}",
  "expiresInMinutes": 60
}

### Get Formats
# Expect: 200
# @name getFormats
GET {{host}}/api/v1/programs/{{programId}}/formats
Authorization: Bearer {{scopedAccessToken}}

### Update Formats
# Expect: 200
# @name updateFormats
PUT {{host}}/api/v1/programs/{{programId}}/formats
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "formats": [
    { "formatCode": "Mcq", "isEnabled": true, "displayOrder": 1, "disabledReason": null },
    { "formatCode": "Passing", "isEnabled": false, "displayOrder": null, "disabledReason": "Not running Passing this year" }
  ]
}

### Get Settings
# Expect: 200
# @name getSettings
GET {{host}}/api/v1/programs/{{programId}}/settings
Authorization: Bearer {{scopedAccessToken}}

### Update Settings
# Expect: 200
# @name updateSettings
PUT {{host}}/api/v1/programs/{{programId}}/settings
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "settings": [
    { "category": "Display", "key": "ShowLeaderboard", "value": "true" }
  ]
}

### Clone Program
# Expect: 201
# @name cloneProgram
POST {{host}}/api/v1/programs/{{programId}}/clone
Authorization: Bearer {{accessToken2}}
Content-Type: application/json

{
  "newProgramCode": "PM-CLONE-{{$randomInt 1000 999999}}",
  "newProgramName": "Postman Test Program (Clone)"
}

### Dashboard
# Expect: 200
# @name dashboard
GET {{host}}/api/v1/programs/{{programId}}/dashboard
Authorization: Bearer {{scopedAccessToken}}


###
### ==================== 03 · Admin ====================

### List Users
# Expect: 200
# @name listUsers
GET {{host}}/api/v1/admin/users
Authorization: Bearer {{accessToken2}}

### Invite User
# Expect: 201
# @name inviteUser
POST {{host}}/api/v1/admin/users
Authorization: Bearer {{accessToken2}}
Content-Type: application/json

{
  "email": "postman-user-{{$randomInt 1000 999999}}@quizapp.test",
  "fullName": "Postman Test User",
  "roles": ["ProgramAdmin"]
}

###
@invitedUserId = {{inviteUser.response.body.$.user.id}}

### Assign Roles (uses {{programId}} from 02 Programs > Create Program)
# Expect: 200
# @name assignRoles
PUT {{host}}/api/v1/admin/users/{{invitedUserId}}/roles
Authorization: Bearer {{accessToken2}}
Content-Type: application/json

{
  "programId": "{{programId}}",
  "roles": ["ProgramAdmin"]
}

### Reset Password
# Expect: 200
# @name resetPassword
POST {{host}}/api/v1/admin/users/{{invitedUserId}}/reset-password
Authorization: Bearer {{accessToken2}}

### Deactivate User
# Expect: 204
# @name deactivateUser
POST {{host}}/api/v1/admin/users/{{invitedUserId}}/deactivate
Authorization: Bearer {{accessToken2}}


