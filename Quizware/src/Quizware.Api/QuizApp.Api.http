POST {{host}}/api/v1/programs/{{programId}}/questions/{{mcqQuestionIdV2}}/approve
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "notes": "Reviewed and approved via Postman"
}

