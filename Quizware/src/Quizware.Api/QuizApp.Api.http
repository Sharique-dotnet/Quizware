GET {{host}}/api/v1/programs/{{programId}}/qualification/stages/{{stageId}}/ties
Authorization: Bearer {{scopedAccessToken}}

### Get Tie (unknown id — expect 404)
# Expect: 404
# @name getTie
GET {{host}}/api/v1/programs/{{programId}}/qualification/ties/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{scopedAccessToken}}

### Create Tie-Break Match (unknown tie — expect 404)
# Expect: 404
# @name createTieBreakMatch
POST {{host}}/api/v1/programs/{{programId}}/qualification/ties/00000000-0000-0000-0000-000000000001/tie-break-match
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "formatCodeOverride": null,
  "questionCountOverride": null,
  "suddenDeathOverride": null,
  "reason": null
}

### Resolve Tie Manually (unknown tie — expect 404)
# Expect: 404
# @name resolveTieManually
POST {{host}}/api/v1/programs/{{programId}}/qualification/ties/00000000-0000-0000-0000-000000000001/resolve-manually
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "rankedTeamIds": [
    "{{teamId}}"
  ],
  "method": "ManualDecision",
  "reason": "Example",
  "approvedByUserId": "{{adminUserId}}"
}

### Abandon Tie (unknown tie — expect 404)
# Expect: 404
# @name abandonTie
POST {{host}}/api/v1/programs/{{programId}}/qualification/ties/00000000-0000-0000-0000-000000000001/abandon
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "reason": "Example"
}

### Commit Qualification
# Expect: 200
# @name commitQualification
POST {{host}}/api/v1/programs/{{programId}}/qualification/stages/{{stageId}}/commit
Authorization: Bearer {{scopedAccessToken}}

### Qualification Preview (after commit)
# Expect: 200
# @name qualificationPreview2
GET {{host}}/api/v1/programs/{{programId}}/qualification/stages/{{stageId}}/preview
Authorization: Bearer {{scopedAccessToken}}

### Rollback Qualification
# Expect: 204
# @name rollbackQualification
POST {{host}}/api/v1/programs/{{programId}}/qualification/stages/{{stageId}}/rollback
Authorization: Bearer {{scopedAccessToken}}

### Commit Qualification (again)
# Expect: 200
# @name commitQualification2
POST {{host}}/api/v1/programs/{{programId}}/qualification/stages/{{stageId}}/commit
Authorization: Bearer {{scopedAccessToken}}

### Auto-Seed Semi-Final (from the committed teams)
# Expect: 200
# @name autoSeedSemiFinal
POST {{host}}/api/v1/programs/{{programId}}/matches/auto-seed
Authorization: Bearer {{scopedAccessToken}}
Content-Type: application/json

{
  "stageId": "{{semiStageId}}",
  "seedingMode": "ByRank"
}


